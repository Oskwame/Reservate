generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
  receptionist
  housekeeping
}

enum RoomType {
  single
  double
  twin
  suite
  deluxe
}

enum RoomStatus {
  available
  occupied
  cleaning
  maintenance
  out_of_service
}

enum Currency {
  USD
  EUR
  GBP
}

enum ReservationStatus {
  pending
  confirmed
  checked_in
  checked_out
  cancelled
  no_show
}

enum InvoiceStatus {
  draft
  issued
  paid
  void
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  role         UserRole @default(receptionist)
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Room {
  id           String        @id @default(uuid()) @db.Uuid
  number       String        @unique
  name         String
  type         RoomType
  status       RoomStatus    @default(available)
  floor        Int
  capacity     Int
  nightlyRate  Decimal       @map("nightly_rate") @db.Decimal(12, 2)
  currency     Currency      @default(USD)
  amenities    RoomAmenity[]
  reservations Reservation[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("rooms")
}

model RoomAmenity {
  id     String @id @default(uuid()) @db.Uuid
  roomId String @map("room_id") @db.Uuid
  name   String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, name])
  @@map("room_amenities")
}

model Guest {
  id           String        @id @default(uuid()) @db.Uuid
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  email        String
  phone        String?
  country      String?
  reservations Reservation[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([email])
  @@map("guests")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  guestId     String            @map("guest_id") @db.Uuid
  roomId      String            @map("room_id") @db.Uuid
  checkIn     DateTime          @map("check_in") @db.Date
  checkOut    DateTime          @map("check_out") @db.Date
  guests      Int
  status      ReservationStatus @default(confirmed)
  totalAmount Decimal           @map("total_amount") @db.Decimal(12, 2)
  currency    Currency          @default(USD)
  notes       String?
  guest       Guest             @relation(fields: [guestId], references: [id])
  room        Room              @relation(fields: [roomId], references: [id])
  invoices    Invoice[]
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([roomId, checkIn, checkOut])
  @@index([status, checkIn])
  @@map("reservations")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  number        String        @unique
  reservationId String        @map("reservation_id") @db.Uuid
  status        InvoiceStatus @default(draft)
  amount        Decimal       @db.Decimal(12, 2)
  currency      Currency      @default(USD)
  issuedAt      DateTime?     @map("issued_at") @db.Timestamptz(3)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(3)
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  payments      Payment[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([reservationId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  provider          String
  providerReference String?       @map("provider_reference")
  amount            Decimal       @db.Decimal(12, 2)
  currency          Currency      @default(USD)
  status            PaymentStatus @default(pending)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  invoice           Invoice       @relation(fields: [invoiceId], references: [id])
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerReference])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}
